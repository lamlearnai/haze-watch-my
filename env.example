# Copy to .env and fill in. .env is gitignored - never commit real values.

# Free key from https://explore.openaq.org (account settings)
OPENAQ_API_KEY=your-key-here

# Postgres. Read by docker compose when the volume is FIRST created - changing
# it later requires ALTER USER inside the container, not just editing this file.
POSTGRES_PASSWORD=choose-something-long

# Host port 5434 avoids clashing with a local Postgres install on 5432/5433.
# Use 127.0.0.1 rather than localhost: localhost may resolve to IPv6 and reach
# a different listener.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=haze
POSTGRES_USER=haze
